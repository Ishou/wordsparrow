{
  "name": "@bliss/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Bliss frontend bounded context (Vite + React 19 + TanStack Router + Panda CSS + Ark UI). See ADR-0002.",
  "scripts": {
    "dev": "pnpm panda:codegen && vite",
    "dev:preview": "pnpm panda:codegen && vite --mode preview",
    "build": "pnpm panda:codegen && tsc -b && vite build && pnpm seo:postbuild",
    "build:preview": "pnpm panda:codegen && tsc -b && vite build --mode preview && pnpm seo:postbuild",
    "seo:postbuild": "node --experimental-strip-types scripts/generate-sitemap.ts && node --experimental-strip-types scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:post-build": "vitest run seo-prerender-output",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "a11y": "playwright test e2e/a11y.spec.ts",
    "lhci": "lhci autorun",
    "typecheck": "pnpm panda:codegen && tsc -b",
    "lint": "eslint .",
    "panda:codegen": "panda codegen --silent",
    "prepare": "pnpm panda:codegen",
    "api:generate": "openapi-typescript ../grid/api/openapi.yaml -o src/infrastructure/api/grid/types.ts && openapi-typescript ../game/api/openapi.yaml -o src/infrastructure/api/game/types.ts && openapi-typescript ../identity/api/openapi.yaml -o src/infrastructure/api/identity/types.ts && openapi-typescript ../survey/api/openapi.yaml -o src/infrastructure/api/survey/types.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/infrastructure/api/grid/types.ts src/infrastructure/api/game/types.ts src/infrastructure/api/identity/types.ts src/infrastructure/api/survey/types.ts"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource/lekton": "^5.2.8",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-document-load": "^0.64.0",
    "@opentelemetry/instrumentation-fetch": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-web": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@tanstack/react-router": "^1.170.15",
    "msw": "^2.14.6",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-zoom-pan-pinch": "^4.0.3",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint-react/eslint-plugin": "^5.9.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@pandacss/dev": "^1.11.3",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontaine": "^0.8.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}